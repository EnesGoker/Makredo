<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Controls are composed in code. Preserve existing designer behavior during retargeting; review serialization metadata in phase 4. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyName>Makredo</AssemblyName>
    <Product>Makredo</Product>
    <Title>Makredo</Title>
    <Company>Enes Göker</Company>
    <Authors>Enes Göker</Authors>
    <ApplicationIcon>Resources\Makredo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Makredo.Application\Makredo.Application.csproj" />
    <ProjectReference Include="..\Makredo.Domain\Makredo.Domain.csproj" />
    <ProjectReference Include="..\Makredo.Infrastructure\Makredo.Infrastructure.csproj" />
    <ProjectReference Include="..\Makredo.Platform.Windows\Makredo.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
